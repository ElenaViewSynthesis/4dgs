# Copy to .env (git-ignored) and fill in. Never commit the filled file.
# The launcher loads .env into the process environment; values are never printed or logged.
WANDB_API_KEY=
# Optional. Project to log to; the entity is taken from the key's default.
WANDB_PROJECT=chronodepth-reg
# Optional alternative to WANDB_API_KEY: name of a secret already stored with the GPU provider.
FDGS_WANDB_SECRET=
